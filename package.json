{
  "name": "starlord",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "sim": "tsx apps/cli/src/main.ts",
    "sim:events": "tsx apps/cli/src/stats.ts",
    "dev": "pnpm --filter @starlord/web dev",
    "build": "pnpm --filter @starlord/web build",
    "balance": "tsx apps/cli/src/balance.ts",
    "replay": "tsx apps/cli/src/replay.ts",
    "soak": "tsx apps/cli/src/soak.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
